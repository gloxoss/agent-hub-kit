{
  "baseBranch": "main",
  "backlogPath": "docs/BACKLOG.md",
  "commitTrailer": null,
  "digestMinutes": 20,
  "opencodeModel": "opencode-go/glm-5.3-flash",
  "hubDir": ".agent-hub",
  "kit": {
    "version": "2.3.0",
    "source": null
  },
  "skillRoots": [
    ".agents/skills",
    ".claude/skills",
    "~/.claude/skills",
    "~/.agents/skills",
    "~/.codex/skills",
    "~/.gemini/skills"
  ],
  "requireSkills": false,
  "checkHealthBeforeDispatch": false,
  "dailyJobLimit": {},
  "resources": {
    "buildMinFreeMB": 2500,
    "reviewMinFreeMB": 2000,
    "maxJobMinutes": 90,
    "maxSilenceMinutes": 20
  },
  "locales": {
    "path": "locales",
    "languages": [
      "en"
    ]
  },
  "audit": {
    "dir": "docs/audit",
    "index": "docs/audit/INDEX.md",
    "fixes": "docs/audit/FIXES.md",
    "pageReports": "docs/audit/pages",
    "plans": "docs/plans"
  },
  "migrationPaths": [
    "drizzle/",
    "migrations/",
    "prisma/migrations/",
    "db/migrations/"
  ],
  "pages": {
    "appRoot": ".",
    "routesDir": "src/app",
    "routePrefix": "",
    "locales": [],
    "reports": "docs/audit/pages",
    "executor": "opencode",
    "skills": []
  },
  "autoCommit": true,
  "planners": "^M-",
  "notifyVisible": null,
  "board": {
    "syncMinutes": 3,
    "enabled": false
  },
  "sync": {
    "minutes": 5,
    "enabled": false
  },
  "worktrees": {
    "enabled": false,
    "base": "../{repo}-wt",
    "install": "auto"
  },
  "manualAccept": [],
  "slowJobFloorMinutes": 90,
  "herdr": {
    "enabled": true,
    "interactive": true,
    "workspaceLabel": "",
    "maxTabs": 14
  }
}
