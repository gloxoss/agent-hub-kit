      "name": "agy",
      "kind": "both",
      "maxSessions": 5,
      "buildCmd": "agy",
      "buildExtraArgs": [
        "-p",
        "{msg}",
        "--output-format",
        "stream-json",
        "--dangerously-skip-permissions"
