      "name": "claude-ds1",
      "kind": "builder",
      "maxSessions": 3,
      "buildCmd": "claude-ds1",
      "buildExtraArgs": [
        "-p",
        "{msg}",
        "--session-id",
        "{sid}",
        "--output-format",
        "stream-json",
        "--verbose",
        "--dangerously-skip-permissions"
      ],
      "reviewCmd": "claude-ds1",
      "reviewExtraArgs": [
