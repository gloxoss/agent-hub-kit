      "maxReviews": 2,
      "reviewCmd": "agy",
      "reviewExtraArgs": [
        "-p",
        "{msg}",
        "--mode",
        "plan",
        "--output-format",
        "stream-json",
        "--dangerously-skip-permissions"
      ],
      "note": "Antigravity CLI. Add the project folder to trustedWorkspaces in ~/.gemini/antigravity-cli/settings.json. For several Google accounts set buildCmd/reviewCmd to \"agy-rotate\" (engine/tools/agy-rotate.mjs + agy-profiles.ps1, see references/executors.md section 6).",
