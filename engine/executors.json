        "{sid}",
        "--output-format",
        "stream-json",
        "--verbose",
        "--dangerously-skip-permissions"
      ],
      "watch": "claude-ds2 --resume {sid}",
      "restore": "Top up the DeepSeek API balance used by claude-ds2.",
      "disabled": false,
      "maxReviews": 2
    },
    {
      "name": "claude-ds3",
      "kind": "builder",
      "maxSessions": 3,
      "buildCmd": "claude-ds3",
      "buildExtraArgs": [
        "-p",
        "{msg}",
        "--session-id",
        "{sid}",
        "--output-format",
        "stream-json",
        "--verbose",
        "--dangerously-skip-permissions"
