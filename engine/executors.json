{
  "buildOrder": [
    "claude-ag2-sonnet",
    "claude-ds2",
    "claude-ds3",
    "claude-ds1",
    "agy",
    "opencode",
    "cursor"
  ],
  "reviewOrder": [
    "codex",
    "cursor",
    "claude-ag2-sonnet",
    "claude-grok",
    "claude"
  ],
  "sharedReviewers": [
    "cursor",
    "claude-ag2-sonnet"
  ],
  "executors": [
    {
      "name": "agy",
      "kind": "builder",
      "maxSessions": 5,
      "buildCmd": "agy",
      "buildExtraArgs": [
        "-p",
        "{msg}",
        "--output-format",
        "stream-json",
        "--dangerously-skip-permissions"
      ],
      "watch": "agy --conversation {sid}",
      "restore": "Check your Antigravity / Gemini quota, or switch model with --model.",
      "disabled": false,
      "maxReviews": 2
    },
    {
      "name": "opencode",
      "kind": "builder",
      "maxSessions": 6,
      "model": "opencode/beam-free",
      "buildCmd": "opencode",
      "buildExtraArgs": [
        "run",
        "-m",
        "{model}",
        "--format",
        "json",
        "--title",
        "{job}",
        "{attach}",
        "{msg}"
      ],
      "watch": "opencode attach http://127.0.0.1:4096  (or: opencode -s {sid})",
      "restore": "Check the opencode provider key and balance (opencode auth list).",
      "disabled": false,
      "maxReviews": 2
    },
    {
      "name": "claude-grok",
      "kind": "both",
      "maxSessions": 2,
      "requiresLauncher": true,
      "buildCmd": "claude-grok",
      "buildExtraArgs": [
        "-p",
        "{msg}",
        "--strict-mcp-config",
        "--session-id",
        "{sid}",
        "--output-format",
        "stream-json",
        "--verbose",
        "--dangerously-skip-permissions"
      ],
      "reviewCmd": "claude-grok",
      "reviewExtraArgs": [
        "--disallowedTools",
        "Edit,Write,NotebookEdit",
        "-p",
        "{msg}",
        "--strict-mcp-config",
        "--session-id",
        "{sid}",
        "--output-format",
        "stream-json",
        "--verbose",
        "--dangerously-skip-permissions"
      ],
      "watch": "claude-grok --resume {sid}",
      "restore": "Create the claude-grok launcher (Claude Code pointed at a CLIProxyAPI account with the grok model), and check that account in CLIProxyAPI.",
      "disabled": false,
      "maxReviews": 2
    },
    {
      "name": "claude-ag2-sonnet",
      "kind": "both",
      "maxSessions": 4,
      "buildCmd": "claude-ag2-sonnet",
