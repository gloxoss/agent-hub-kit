        "{msg}",
        "--strict-mcp-config",
        "--session-id",
        "{sid}",
        "--output-format",
        "stream-json",
        "--verbose",
        "--dangerously-skip-permissions"
      ],
      "watch": "claude-ag2-sonnet --resume {sid}",
      "restore": "Check the Antigravity Claude weekly quota (node .agent-hub/quota.mjs); the launcher starts its proxy on 8080.",
      "disabled": false,
      "maxReviews": 2
    },
    {
      "name": "claude-ds2",
      "kind": "builder",
      "maxSessions": 3,
