      "watch": "claude-ds1 --resume {sid}",
      "restore": "Top up the DeepSeek API balance used by claude-ds1.",
      "disabled": false,
      "maxReviews": 2
    },
    {
      "name": "claude-ag2-gemini",
      "kind": "both",
      "maxSessions": 5,
      "buildCmd": "claude-ag2-gemini",
      "buildExtraArgs": [
        "-p",
        "{msg}",
        "--strict-mcp-config",
        "--tools",
        "Bash,Read,Edit,Write,Glob,Grep",
        "--session-id",
        "{sid}",
        "--output-format",
        "stream-json",
        "--verbose",
        "--dangerously-skip-permissions"
      ],
      "reviewCmd": "claude-ag2-gemini",
      "reviewExtraArgs": [
        "--disallowedTools",
        "Edit,Write,NotebookEdit",
        "-p",
        "{msg}",
        "--strict-mcp-config",
        "--tools",
        "Bash,Read,Edit,Write,Glob,Grep",
        "--session-id",
        "{sid}",
        "--output-format",
        "stream-json",
        "--verbose",
        "--dangerously-skip-permissions"
      ],
      "watch": "claude-ag2-gemini --resume {sid}",
      "restore": "The launcher auto-starts its proxy on 8080; Gemini rejects some Claude Code tool schemas, so it runs with --strict-mcp-config and 6 tools. The first call after a cold start can take minutes; if it fails, run the launcher once by hand.",
      "disabled": false,
      "maxReviews": 2
    },
    {
      "name": "claude",
      "kind": "both",
      "maxSessions": 1,
      "buildCmd": "claude",
      "buildExtraArgs": [
        "-p",
        "{msg}",
        "--session-id",
        "{sid}",
        "--output-format",
        "stream-json",
        "--verbose",
        "--dangerously-skip-permissions"
      ],
      "reviewCmd": "claude",
      "reviewExtraArgs": [
        "--disallowedTools",
        "Edit,Write,NotebookEdit",
        "-p",
        "{msg}",
        "--session-id",
        "{sid}",
        "--output-format",
        "stream-json",
        "--verbose",
        "--dangerously-skip-permissions"
      ],
      "watch": "claude --resume {sid}",
      "restore": "Claude plan usage limit: wait for the reset or switch account.",
      "disabled": false,
      "maxReviews": 2
    },
    {
      "name": "codex",
      "kind": "reviewer",
      "maxSessions": 2,
      "buildCmd": "codex",
      "buildExtraArgs": [
        "exec",
        "--json",
        "--skip-git-repo-check",
        "--sandbox",
        "workspace-write",
        "{msg}"
      ],
      "reviewCmd": "codex",
      "reviewExtraArgs": [
        "exec",
        "--json",
        "--skip-git-repo-check",
        "-c",
        "model_reasoning_effort=\"low\"",
        "--sandbox",
        "read-only",
        "--output-last-message",
        "{outFile}",
        "{msg}"
      ],
      "watch": "codex resume {sid}",
      "restore": "Codex / ChatGPT usage limit: wait for the reset, or run codex login with another account.",
      "disabled": false,
      "maxReviews": 2
    },
    {
      "name": "cursor",
      "kind": "both",
      "maxSessions": 3,
      "buildCmd": "cursor-agent",
      "buildExtraArgs": [
        "-p",
        "--force",
        "--output-format",
        "stream-json",
        "{msg}"
      ],
      "reviewCmd": "cursor-agent",
      "reviewExtraArgs": [
        "-p",
        "--trust",
        "--output-format",
        "stream-json",
        "{msg}"
      ],
      "watch": null,
      "restore": "Run `cursor agent` once interactively to install and log in.",
      "disabled": false,
      "maxReviews": 2,
      "healthTimeoutSec": 240
    },
    {
      "name": "oc-glm",
