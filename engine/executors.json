        "--title",
        "{job}",
        "{attach}",
        "{msg}"
      ],
      "watch": "opencode attach http://127.0.0.1:4096  (or: opencode -s {sid})",
      "restore": "Check the opencode provider key and balance (opencode auth list).",
      "tier": 1,
      "fit": "complex frontend and visual coding loops",
      "disabled": true,
      "disabledNote": "Owner 2026-10-18: GLM-5.3 free endpoint returns 503 Endpoint is unavailable. Do not use until fixed; remove this flag to re-enable."
